# ==============================================================================
# NAGARDRISHTI — ENVIRONMENT CONFIGURATION TEMPLATE
# Madhya Pradesh Geospatial Civic Intelligence and Feedback Analytics Platform
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=NagarDrishti
API_V1_PREFIX=/v1

# Frontend / Backend URLs (CORS configuration)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Supabase Configuration
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
# CRITICAL: SUPABASE_SERVICE_ROLE_KEY MUST NEVER BE EXPOSED TO THE FRONTEND
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# PostgreSQL / PostGIS Database Connection
# Format: postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
# Or psycopg: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# AI Services — Sarvam AI Configuration (Server-Side Only)
# Obtain from: https://dashboard.sarvam.ai/
SARVAM_API_KEY=your-sarvam-api-key-here
SARVAM_BASE_URL=https://api.sarvam.ai

# External Geospatial / Government Services Configuration
# ISRO Bhuvan API (https://bhuvan-app1.nrsc.gov.in/api/)
BHUVAN_API_KEY=optional-bhuvan-api-token
BHUVAN_BASE_URL=https://bhuvan-app1.nrsc.gov.in/api

# Open Government Data (OGD) Platform India (https://data.gov.in/)
DATA_GOV_IN_API_KEY=optional-ogd-api-key

# MP eService Open API (https://www.services.mp.gov.in/eservice/openAPI)
MP_ESERVICE_API_URL=https://www.services.mp.gov.in/eservice/openAPI

# GARUD MP / Directorate of Urban Administration & Development
GARUD_PORTAL_URL=https://www.urbangis.mp.gov.in/

# Routing Engine (OSRM / OpenRouteService / GraphHopper)
ROUTING_PROVIDER=osrm
ROUTING_API_URL=https://router.project-osrm.org
ROUTING_API_KEY=optional-routing-key

# Map Tiles / Basemaps Configuration (Optional MapLibre / MapTiler / OSM Keys)
MAPTILER_API_KEY=optional-maptiler-key-for-vector-tiles
DEFAULT_MAP_LAT=26.2183
DEFAULT_MAP_LNG=78.1828
DEFAULT_MAP_ZOOM=12

# Security & Rate Limiting
SECRET_KEY=generate-a-secure-random-32-byte-hex-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RATE_LIMIT_PER_MINUTE=60
