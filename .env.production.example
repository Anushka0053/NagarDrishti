# ==============================================================================
# NAGARDRISHTI — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env.production on target production host and fill with production secrets
# ==============================================================================

# Application Runtime
ENVIRONMENT=production
DEBUG=false
APP_NAME=NagarDrishti API
API_V1_PREFIX=/v1
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated list of fully-qualified domain origins)
ALLOWED_ORIGINS=https://nagardrishti.mp.gov.in,https://admin.nagardrishti.mp.gov.in

# Database Configuration (PostGIS 16 + PostGIS 3.4)
POSTGRES_DB=nagardrishti
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SetAStrongRandomPasswordHere_32CharsMinimum!
DATABASE_URL=postgresql://postgres:SetAStrongRandomPasswordHere_32CharsMinimum!@db:5432/nagardrishti
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# Supabase Auth & JWT Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-string-at-least-32-chars

# Sarvam AI Sovereignty Configuration
# Production API Key from https://dashboard.sarvam.ai
SARVAM_API_KEY=your_production_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_DEFAULT_SPEAKER=meera

# Geospatial Provider Integration
ROUTING_API_URL=https://router.project-osrm.org
GEOCODING_USER_AGENT=NagarDrishti-Production/1.0 (contact: support@nagardrishti.mp.gov.in)
BHUVAN_BASE_URL=https://bhuvan-app1.nrsc.gov.in/api
BHUVAN_API_KEY=
MP_ESERVICE_API_URL=https://www.services.mp.gov.in/eservice/openAPI
GARUD_PORTAL_URL=https://www.urbangis.mp.gov.in/

