# Backend Environment Configuration
ENVIRONMENT=development
DEBUG=True
APP_NAME=NagarDrishti API
API_V1_PREFIX=/v1

# Server Bindings
HOST=0.0.0.0
PORT=8000

# CORS Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Connection (Supabase PostgreSQL / PostGIS)
# Example: postgresql://postgres.your-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nagardrishti
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Supabase Auth & Storage Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Sarvam AI API Configuration
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_BASE_URL=https://api.sarvam.ai

# External Geospatial Services
BHUVAN_API_KEY=optional-bhuvan-key
BHUVAN_BASE_URL=https://bhuvan-app1.nrsc.gov.in/api
DATA_GOV_IN_API_KEY=optional-ogd-key
MP_ESERVICE_API_URL=https://www.services.mp.gov.in/eservice/openAPI
GARUD_PORTAL_URL=https://www.urbangis.mp.gov.in/
ROUTING_API_URL=https://router.project-osrm.org
